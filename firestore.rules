rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userRole(role) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }
    function validAvatarDataField(fieldName) {
      return !(fieldName in request.resource.data)
        || request.resource.data[fieldName] == ''
        || (request.resource.data[fieldName] is string
          && request.resource.data[fieldName].size() <= 150000
          && request.resource.data[fieldName].matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$'));
    }
    function validAvatarPresetField(fieldName) {
      return !(fieldName in request.resource.data)
        || request.resource.data[fieldName] in ['fern', 'ocean', 'sun', 'violet', 'clay', 'midnight', 'rose', 'sky'];
    }
    function validUser(uid) {
      return request.resource.data.keys().hasOnly(['uid', 'name', 'role', 'avatarData', 'avatarPreset', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['uid', 'name', 'role', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.role in ['business', 'customer']
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && validAvatarDataField('avatarData') && validAvatarPresetField('avatarPreset');
    }
    function validBusiness(uid) {
      return request.resource.data.keys().hasOnly(['ownerUid', 'name', 'category', 'about', 'offersText', 'phone', 'currency', 'photoData', 'avatarPreset', 'workingDays', 'openTime', 'closeTime', 'meetingMinutes', 'slotMinutes', 'backupTime', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['ownerUid', 'name', 'category', 'about', 'offersText', 'phone', 'currency', 'workingDays', 'openTime', 'closeTime', 'meetingMinutes', 'slotMinutes', 'backupTime', 'createdAt', 'updatedAt'])
        && request.resource.data.ownerUid == uid
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
        && request.resource.data.category is string && request.resource.data.category.size() > 0 && request.resource.data.category.size() <= 80
        && request.resource.data.about is string && request.resource.data.about.size() <= 900
        && request.resource.data.offersText is string && request.resource.data.offersText.size() <= 900
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 40
        && request.resource.data.currency is string && request.resource.data.currency.size() <= 8
        && request.resource.data.workingDays is list && request.resource.data.workingDays.size() <= 7
        && request.resource.data.openTime is string && request.resource.data.openTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && request.resource.data.closeTime is string && request.resource.data.closeTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && request.resource.data.meetingMinutes in [30, 45, 60, 90, 120]
        && request.resource.data.slotMinutes in [15, 30, 60]
        && request.resource.data.backupTime is string && request.resource.data.backupTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && request.resource.data.createdAt is timestamp && request.resource.data.updatedAt is timestamp
        && validAvatarDataField('photoData') && validAvatarPresetField('avatarPreset');
    }
    function validOffer(uid) {
      return request.resource.data.keys().hasOnly(['ownerUid', 'name', 'type', 'description', 'price', 'amountCents', 'currency', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['ownerUid', 'name', 'type', 'description', 'price', 'createdAt', 'updatedAt'])
        && request.resource.data.ownerUid == uid
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.type in ['Service', 'Product']
        && request.resource.data.description is string && request.resource.data.description.size() <= 240
        && request.resource.data.price is string && request.resource.data.price.size() > 0 && request.resource.data.price.size() <= 40
        && (!('amountCents' in request.resource.data) || (request.resource.data.amountCents is int && (request.resource.data.amountCents == 0 || request.resource.data.amountCents >= 100) && request.resource.data.amountCents <= 100000000))
        && (!('currency' in request.resource.data) || (request.resource.data.currency is string && request.resource.data.currency.size() <= 8))
        && request.resource.data.createdAt is timestamp && request.resource.data.updatedAt is timestamp;
    }
    function validBooking() {
      return request.resource.data.keys().hasOnly(['businessId', 'businessName', 'businessAvatarData', 'businessAvatarPreset', 'category', 'customerUid', 'customerName', 'customerEmail', 'customerAvatarData', 'customerAvatarPreset', 'customerPhone', 'offerId', 'offerName', 'amountCents', 'currency', 'paymentStatus', 'orderDetail', 'assistance', 'preferredDate', 'preferredTime', 'backupDate', 'backupTime', 'alternateTime', 'note', 'status', 'confirmedDate', 'confirmedTime', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['businessId', 'businessName', 'category', 'customerUid', 'customerName', 'customerEmail', 'customerPhone', 'offerId', 'offerName', 'orderDetail', 'assistance', 'preferredDate', 'preferredTime', 'backupDate', 'backupTime', 'alternateTime', 'note', 'status', 'confirmedDate', 'confirmedTime', 'createdAt', 'updatedAt'])
        && request.resource.data.businessId is string && request.resource.data.businessId.size() <= 128
        && request.resource.data.businessName is string && request.resource.data.businessName.size() <= 120
        && request.resource.data.category is string && request.resource.data.category.size() <= 80
        && request.resource.data.customerUid is string && request.resource.data.customerUid.size() <= 128
        && request.resource.data.customerName is string && request.resource.data.customerName.size() <= 80
        && request.resource.data.customerEmail is string && request.resource.data.customerEmail.size() <= 254
        && request.resource.data.customerPhone is string && request.resource.data.customerPhone.size() <= 40
        && request.resource.data.offerId is string && request.resource.data.offerId.size() <= 128
        && request.resource.data.offerName is string && request.resource.data.offerName.size() <= 100
        && (!('amountCents' in request.resource.data) || (request.resource.data.amountCents is int && request.resource.data.amountCents >= 0 && request.resource.data.amountCents <= 100000000))
        && (!('currency' in request.resource.data) || (request.resource.data.currency is string && request.resource.data.currency.size() <= 8))
        && (!('paymentStatus' in request.resource.data) || request.resource.data.paymentStatus in ['Unpaid', 'NotRequired'])
        && request.resource.data.orderDetail is string && request.resource.data.orderDetail.size() <= 700
        && request.resource.data.assistance is string && request.resource.data.assistance.size() > 0 && request.resource.data.assistance.size() <= 100
        && request.resource.data.preferredDate is string && request.resource.data.preferredDate.size() == 10
        && request.resource.data.preferredTime is string && request.resource.data.preferredTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && request.resource.data.backupDate is string && request.resource.data.backupDate.size() == 10
        && request.resource.data.backupTime is string && request.resource.data.backupTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && request.resource.data.alternateTime is string && request.resource.data.alternateTime.size() <= 120
        && request.resource.data.note is string && request.resource.data.note.size() <= 700
        && request.resource.data.status == 'Pending'
        && request.resource.data.confirmedDate == '' && request.resource.data.confirmedTime == ''
        && request.resource.data.createdAt is timestamp && request.resource.data.updatedAt is timestamp
        && validAvatarDataField('businessAvatarData') && validAvatarPresetField('businessAvatarPreset')
        && validAvatarDataField('customerAvatarData') && validAvatarPresetField('customerAvatarPreset');
    }
    function validMessage() {
      return request.resource.data.keys().hasOnly(['senderUid', 'senderName', 'text', 'createdAt'])
        && request.resource.data.keys().hasAll(['senderUid', 'senderName', 'text', 'createdAt'])
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.senderName is string && request.resource.data.senderName.size() > 0 && request.resource.data.senderName.size() <= 80
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
        && request.resource.data.createdAt is timestamp;
    }
    function canReadBooking(data) {
      return signedIn() && (data.customerUid == request.auth.uid || data.businessId == request.auth.uid);
    }

    // Users can create their own immutable role record and read it; roles cannot be changed client-side.
    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid && validUser(uid);
      allow get: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid && validUser(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'avatarData', 'avatarPreset', 'updatedAt']);
      allow list, delete: if false;
    }

    // Signed-in customers can discover listings. Only the matching business owner can edit them.
    match /businesses/{uid} {
      allow get, list: if signedIn();
      allow create: if userRole('business') && request.auth.uid == uid && validBusiness(uid);
      allow update: if userRole('business') && request.auth.uid == uid && validBusiness(uid)
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if false;
      match /offers/{offerId} {
        allow get, list: if signedIn();
        allow create: if userRole('business') && request.auth.uid == uid && validOffer(uid);
        allow update: if userRole('business') && request.auth.uid == uid && validOffer(uid)
          && request.resource.data.ownerUid == resource.data.ownerUid;
        allow delete: if userRole('business') && request.auth.uid == uid && resource.data.ownerUid == uid;
      }
    }

    // Booking records and slot reservations are written through callable functions so
    // availability checks and reservation changes commit atomically on the server.
    match /bookings/{bookingId} {
      allow get, list: if canReadBooking(resource.data);
      allow create, update, delete: if false;
      match /events/{eventId} {
        allow get, list: if canReadBooking(get(/databases/$(database)/documents/bookings/$(bookingId)).data);
        allow create, update, delete: if false;
      }
      match /calls/{callId} {
        function booking() { return get(/databases/$(database)/documents/bookings/$(bookingId)).data; }
        function callParticipant(data) {
          return canReadBooking(booking()) && (data.callerUid == request.auth.uid || data.calleeUid == request.auth.uid);
        }
        function validDescription(value) {
          return value is map && value.keys().hasOnly(['type', 'sdp'])
            && value.keys().hasAll(['type', 'sdp']) && value.type in ['offer', 'answer']
            && value.sdp is string && value.sdp.size() > 0 && value.sdp.size() <= 16000;
        }
        allow get, list: if canReadBooking(booking());
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['callerUid', 'calleeUid', 'callerName', 'status', 'offer', 'createdAt', 'updatedAt'])
          && request.resource.data.keys().hasAll(['callerUid', 'calleeUid', 'callerName', 'status', 'offer', 'createdAt', 'updatedAt'])
          && canReadBooking(booking()) && request.resource.data.callerUid == request.auth.uid
          && request.resource.data.calleeUid == (request.auth.uid == booking().customerUid ? booking().businessId : booking().customerUid)
          && request.resource.data.callerName is string && request.resource.data.callerName.size() > 0 && request.resource.data.callerName.size() <= 80
          && request.resource.data.status == 'ringing' && validDescription(request.resource.data.offer)
          && request.resource.data.createdAt is timestamp && request.resource.data.updatedAt is timestamp;
        allow update: if callParticipant(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer', 'status', 'updatedAt'])
          && request.resource.data.callerUid == resource.data.callerUid
          && request.resource.data.calleeUid == resource.data.calleeUid
          && request.resource.data.offer == resource.data.offer
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt is timestamp
          && ((request.auth.uid == resource.data.calleeUid && resource.data.status == 'ringing'
              && ((request.resource.data.status == 'active' && validDescription(request.resource.data.answer))
                || request.resource.data.status == 'declined'))
            || (request.auth.uid == resource.data.callerUid && request.resource.data.status == 'ended')
            || (request.auth.uid == resource.data.calleeUid && request.resource.data.status == 'ended'));
        allow delete: if false;

        match /callerCandidates/{candidateId} {
          allow get, list: if canReadBooking(get(/databases/$(database)/documents/bookings/$(bookingId)).data);
          allow create: if signedIn()
            && request.auth.uid == get(/databases/$(database)/documents/bookings/$(bookingId)/calls/$(callId)).data.callerUid
            && canReadBooking(get(/databases/$(database)/documents/bookings/$(bookingId)).data)
            && request.resource.data.keys().hasOnly(['candidate', 'sdpMid', 'sdpMLineIndex', 'createdAt'])
            && request.resource.data.keys().hasAll(['candidate', 'createdAt'])
            && request.resource.data.candidate is string && request.resource.data.candidate.size() <= 4096
            && (!('sdpMid' in request.resource.data) || request.resource.data.sdpMid == null || (request.resource.data.sdpMid is string && request.resource.data.sdpMid.size() <= 80))
            && (!('sdpMLineIndex' in request.resource.data) || request.resource.data.sdpMLineIndex == null || request.resource.data.sdpMLineIndex is int)
            && request.resource.data.createdAt is timestamp;
          allow update, delete: if false;
        }
        match /calleeCandidates/{candidateId} {
          allow get, list: if canReadBooking(get(/databases/$(database)/documents/bookings/$(bookingId)).data);
          allow create: if signedIn()
            && request.auth.uid == get(/databases/$(database)/documents/bookings/$(bookingId)/calls/$(callId)).data.calleeUid
            && canReadBooking(get(/databases/$(database)/documents/bookings/$(bookingId)).data)
            && request.resource.data.keys().hasOnly(['candidate', 'sdpMid', 'sdpMLineIndex', 'createdAt'])
            && request.resource.data.keys().hasAll(['candidate', 'createdAt'])
            && request.resource.data.candidate is string && request.resource.data.candidate.size() <= 4096
            && (!('sdpMid' in request.resource.data) || request.resource.data.sdpMid == null || (request.resource.data.sdpMid is string && request.resource.data.sdpMid.size() <= 80))
            && (!('sdpMLineIndex' in request.resource.data) || request.resource.data.sdpMLineIndex == null || request.resource.data.sdpMLineIndex is int)
            && request.resource.data.createdAt is timestamp;
          allow update, delete: if false;
        }
      }
      match /messages/{messageId} {
        function parentBooking() { return get(/databases/$(database)/documents/bookings/$(bookingId)).data; }
        allow get, list: if canReadBooking(parentBooking());
        allow create: if canReadBooking(parentBooking()) && validMessage();
        allow update, delete: if false;
      }
    }

    // Slot locks are private to server code. Admin SDK calls from Cloud Functions
    // bypass these rules, while clients cannot manufacture or remove reservations.
    match /bookingSlots/{slotId} {
      allow read, write: if false;
    }

    // Payout configuration is created only by trusted server code; an owner can inspect status.
    match /businessPayouts/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    // Payment records are visible to the booking participants and writable only by server code.
    match /payments/{reference} {
      allow get: if signedIn() && (resource.data.customerUid == request.auth.uid || resource.data.businessId == request.auth.uid);
      allow list, create, update, delete: if false;
    }

    // A signed-in account may register its own browser push subscription. The server
    // uses ownerUid to send appointment, chat, and voice-call alerts.
    match /pushTokens/{tokenId} {
      function validPushToken() {
        return request.resource.data.keys().hasOnly(['ownerUid', 'token', 'updatedAt'])
          && request.resource.data.keys().hasAll(['ownerUid', 'token', 'updatedAt'])
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.token is string && request.resource.data.token.size() > 0 && request.resource.data.token.size() <= 4096
          && tokenId.matches('^[0-9a-f]{64}$')
          && request.resource.data.updatedAt is timestamp;
      }
      allow get, list: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create, update: if signedIn() && validPushToken();
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
